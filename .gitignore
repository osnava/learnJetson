# Video files - only commit GIFs
*.mp4

# Allow GIF files
!*.gif

# Claude Code configuration
.claude/

# Jetson agent inventory — real IPs/MACs/UUIDs never go in a public repo
agent/inventory.sh
agent/inventory.md

# Hardware-doc corpus — fetched & converted on demand (agent/hw-docs/fetch.sh),
# never committed (NVIDIA redistribution terms; the committed map is INDEX.md)
agent/hw-docs/pdf/
agent/hw-docs/md/
agent/hw-docs/__pycache__/
agent/hw-docs/eval/__pycache__/

# Cold-session eval: verbatim transcripts stay operator-side (like the
# corpus); the committed copy under results/ keeps structure with
# tool-result bodies truncated
agent/hw-docs/eval/results/**/raw/

# Cosmos serving env — the real file lives on the Jetson (~/.cosmos-env), never in the repo
agent/cosmos-env
.cosmos-env

# Local handoff docs — environment details never go in a public repo
JETSON_DEV_HANDOFF.md
JETSON_RECOVERY_HANDOFF.md

# Local agent-tool wiring — read from disk by the tools, never published
# (AGENTS.md and CLAUDE.md are tracked: routing only, no personal wiring)
/graft/
/.mcp.json
/.ignore
agent/hw-docs/explore/*
!agent/hw-docs/explore/FINDINGS.md

# Local agent-tool state (ZCode + its plugins) — never part of the repo
/.zcode/
/.v2c/
/tmpwebapp-*.log

# Local plans/ideas scratch space — never part of the repo
/plans_ideas/
