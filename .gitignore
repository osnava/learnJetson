# Video files - only commit GIFs
*.mp4

# Allow GIF files
!*.gif

# Claude Code configuration
.claude/

# Jetson agent inventory — real IPs/MACs/UUIDs never go in a public repo
agent/inventory.sh
agent/inventory.md

# Hardware-doc corpus — fetched & converted on demand (agent/hw-docs/fetch.sh),
# never committed (NVIDIA redistribution terms; the committed map is INDEX.md)
agent/hw-docs/pdf/
agent/hw-docs/md/
agent/hw-docs/__pycache__/

# Cosmos serving env — the real file lives on the Jetson (~/.cosmos-env), never in the repo
agent/cosmos-env
.cosmos-env

# Local handoff docs — environment details never go in a public repo
JETSON_DEV_HANDOFF.md
JETSON_RECOVERY_HANDOFF.md

# Local agent-tool wiring — read from disk by the tools, never published
/graft/
/.mcp.json
/.ignore
/AGENTS.md
